#!/usr/bin/env bash
# Real evidence that the kernel pin (see
# docs/kernel-nexmon-compatibility.md) actually survives a real apt
# upgrade cycle on deployed hardware — not just "the hold is set", but
# "apt full-upgrade genuinely does not change the kernel". Run as root
# on the real device. Does NOT run automatically as part of image
# validation — this performs a real package upgrade, a deliberate,
# higher-impact operation the operator should choose to run.
set -u
FAIL=0
check() {
  local desc="$1"; shift
  if "$@"; then
    echo "PASS: ${desc}"
  else
    echo "FAIL: ${desc}"
    FAIL=1
  fi
}

echo "=== before: pinned kernel version ==="
BEFORE_KVER="$(uname -r)"
echo "running kernel: ${BEFORE_KVER}"
BEFORE_PKG_VER="$(dpkg-query -W -f='${Version}' linux-image-rpi-v8 2>/dev/null)"
echo "linux-image-rpi-v8 installed version: ${BEFORE_PKG_VER}"

echo
echo "=== apt update ==="
apt-get update
check "apt update succeeded" true

echo
echo "=== apt full-upgrade --dry-run (simulated) ==="
DRYRUN_OUT="$(apt-get full-upgrade --dry-run 2>&1)"
echo "$DRYRUN_OUT"
check "dry-run does not propose upgrading linux-image-rpi-v8/rpi-2712" bash -c "! echo \"\$DRYRUN_OUT\" | grep -E 'Inst linux-image-rpi-(v8|2712)'"
check "dry-run does not propose upgrading the real underlying kernel package" bash -c "! echo \"\$DRYRUN_OUT\" | grep -E 'Inst linux-image-6\.'"

echo
echo "=== real apt full-upgrade (this actually changes packages — real operation, not simulated) ==="
apt-get full-upgrade -y
check "apt full-upgrade completed" true

echo
echo "=== after: kernel version (package DB, not yet rebooted) ==="
AFTER_PKG_VER="$(dpkg-query -W -f='${Version}' linux-image-rpi-v8 2>/dev/null)"
echo "linux-image-rpi-v8 installed version: ${AFTER_PKG_VER}"
check "linux-image-rpi-v8 version unchanged by the real upgrade" bash -c "[ '$BEFORE_PKG_VER' = '$AFTER_PKG_VER' ]"

echo
echo "=== held packages still held after the upgrade ==="
apt-mark showhold
check "kernel packages are still held" bash -c "apt-mark showhold | grep -q linux-image"

echo
echo "NOTE: uname -r above reflects the CURRENTLY RUNNING kernel, which"
echo "cannot change without a reboot regardless of what's installed."
echo "Re-run this script's 'before'/'after' package-version comparison"
echo "again after a real reboot to confirm the running kernel also"
echo "stayed on the pinned line, not just the installed package."

echo
echo "=========================================="
if [ "$FAIL" -eq 0 ]; then
  echo "ALL UPGRADE-SAFETY CHECKS PASSED"
else
  echo "ONE OR MORE UPGRADE-SAFETY CHECKS FAILED — the kernel pin did not survive a real apt full-upgrade"
fi
exit "$FAIL"
