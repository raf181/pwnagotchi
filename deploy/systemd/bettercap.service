[Unit]
Description=bettercap api.rest service.
Documentation=https://bettercap.org
Wants=network.target

[Service]
Type=simple
LimitNOFILE=65535
TasksMax=infinity
ExecStart=/usr/bin/bettercap-launcher
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
